    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => ({\n  json: item.json,\n  binary: {\n    data: {\n      ...item.binary.data,\n      mimeType: 'text/csv',\n      fileName: 'data.csv'\n    }\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        944,
        80
      ],
      "id": "394dcbbb-fa61-49de-8e78-1a1607e924c0",
      "name": "Normalize CSV"
    },
    {
      "parameters": {
        "jsCode": "const firstItem = $input.first().json;\n   if (firstItem.status === \"error\") {\n     return [{ json: firstItem }]; // passa l'errore così com'è, non tenta di processare righe\n   }\n\nconst items = $input.all();\nconst rows = items.map(i => i.json);\n\nif (rows.length === 0) {\n  return [{ json: { status: \"error\", reason: \"no rows extracted\" } }];\n}\n\n// Shuffle (Fisher-Yates) — invariato\nfor (let i = rows.length - 1; i > 0; i--) {\n  const j = Math.floor(Math.random() * (i + 1));\n  [rows[i], rows[j]] = [rows[j], rows[i]];\n}\n\nconst columns = Object.keys(rows[0]);\n\n// NUOVO: legge quante righe vuole il chiamante (Case 3 o Case 4)\nconst requestedSize = parseInt($('When Executed by Another Workflow').first().json.sample_size);\nconst targetSize = (!isNaN(requestedSize) && requestedSize > 0) ? requestedSize : 30;\n\n// NUOVO: non si può campionare più righe di quante il dataset ne abbia davvero\nconst effectiveTarget = Math.min(targetSize, rows.length);\n\nconst labelCandidates = columns.filter(c =>\n  /label|class|target|category|sentiment|spam|type/i.test(c)\n);\n\nlet sampledRows;\n\nif (labelCandidates.length > 0) {\n  const labelCol = labelCandidates[0];\n  const groups = {};\n  for (const r of rows) {\n    const v = r[labelCol];\n    if (!groups[v]) groups[v] = [];\n    groups[v].push(r);\n  }\n  const numGroups = Object.keys(groups).length;\n  const perGroup = Math.max(5, Math.ceil(effectiveTarget / numGroups)); // MODIFICATO: 30 -> effectiveTarget\n  sampledRows = Object.values(groups).flatMap(g => g.slice(0, perGroup));\n} else {\n  sampledRows = rows.slice(0, effectiveTarget); // MODIFICATO: 40 -> effectiveTarget\n}\n\nconst sampleText = [columns.join(\",\")]\n  .concat(sampledRows.map(r => columns.map(c => r[c]).join(\",\")))\n  .join(\"\\n\");\n\nreturn [{\n  json: {\n    status: \"ok\",\n    columns,\n    total_rows: rows.length,\n    sample_text: sampleText\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "id": "31bd83b4-e721-41ef-8932-ea9e4066784d",
      "name": "Sample & Balance"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length !== 1) {\n  return [{ json: { status: \"error\", reason: \"zip contains zero or multiple files\" } }];\n}\n\nconst item = items[0];\nconst binaryKeys = Object.keys(item.binary || {});\n\nif (binaryKeys.length !== 1) {\n  return [{ json: { status: \"error\", reason: \"unexpected binary structure after decompression\" } }];\n}\n\nconst binaryKey = binaryKeys[0];\n\nreturn [\n  {\n    json: item.json,\n    binary: {\n      data: {\n        ...item.binary[binaryKey],\n        mimeType: 'text/csv',\n        fileName: 'data.csv'\n      }\n    }\n  }\n];"
      },
