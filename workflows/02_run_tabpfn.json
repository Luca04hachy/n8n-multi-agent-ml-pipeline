    {
      "parameters": {
        "jsCode": "const predictResult = $input.first().json;\nconst buildData = $('Build Train/Test CSV').first().json;\nconst parseData = $('Parse & Compute Stats').first().json;\n\nreturn [{\n  json: {\n    task: buildData.task,\n    target_column: parseData.targetColumn,\n    prediction: predictResult.prediction,\n    metadata: predictResult.metadata\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
