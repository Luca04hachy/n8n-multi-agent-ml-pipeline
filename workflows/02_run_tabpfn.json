      ],
      "id": "92a91704-e693-4337-acf4-2800fa232de5",
      "name": "Format Result"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst { rows, featureColumns, targetColumn, columnStats, task_type } = data;\n\n// X_train: tutte le righe campionate, solo colonne feature\nconst header = featureColumns.join(\",\");\nconst xTrainRows = rows.map(r => featureColumns.map(c => r[c]).join(\",\"));\nconst x_train_csv = [header, ...xTrainRows].join(\"\\n\");\n\n// y_train: solo la colonna target\nconst y_train_csv = [targetColumn, ...rows.map(r => r[targetColumn])].join(\"\\n\");\n\n// X_test: singola riga, mapping LLM + fallback su media/moda\nconst instanceFeatures = {};\nconst raw = (data.instance_features || \"\").trim();\nif (raw.length > 0) {\n  raw.split(\";\").forEach(pair => {\n    const idx = pair.indexOf(\"=\");\n    if (idx > -1) {\n      const key = pair.slice(0, idx).trim();\n      const value = pair.slice(idx + 1).trim();\n      if (key) instanceFeatures[key] = value;\n    }\n  });\n}\n\nconst testRowValues = featureColumns.map(col => {\n  const provided = instanceFeatures[col];\n  const isUsable = provided !== undefined && provided !== null && provided !== \"\";\n  return isUsable ? provided : columnStats[col].fallback;\n  // Nota: le chiavi di instanceFeatures che NON corrispondono a nessuna\n  // featureColumn vengono semplicemente non lette qui sopra -> ignorate.\n});\nconst x_test_csv = [header, testRowValues.join(\",\")].join(\"\\n\");\n\nreturn [{\n  json: {\n    x_train_csv,\n    y_train_csv,\n    x_test_csv,\n    task: task_type\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "id": "2bc74ce5-b286-432d-b241-c8f4e45d5006",
      "name": "Build Train/Test CSV"
    },
    {
      "parameters": {
        "jsCode": "const sampleResult = $input.first().json; // output del nodo Execute Workflow\n\nif (sampleResult.status !== \"ok\") {\n  throw new Error(\"Fetch_Dataset_Sample (re-fetch interno) fallito: \" + (sampleResult.reason || \"motivo sconosciuto\"));\n}\n\nconst trigger = $('When Executed by Another Workflow').first().json;\n\nconst raw = sampleResult.sample_text;\nconst lines = raw.trim().split(\"\\n\");\nconst columns = lines[0].split(\",\");\nconst allRows = lines.slice(1).map(line => {\n  const values = line.split(\",\");\n  const obj = {};\n  columns.forEach((col, i) => { obj[col] = values[i]; });\n  return obj;\n});\n\nconst targetColumn = trigger.target_column;\n\n// NUOVO: scarta le righe dove il target è mancante/vuoto — TabPFN rifiuta\n// una coppia X_train/y_train con conteggi di riga diversi, e righe con\n// target vuoto produrrebbero esattamente questo disallineamento.\nconst rows = allRows.filter(r => r[targetColumn] !== undefined && r[targetColumn].trim() !== \"\");\n\nif (rows.length === 0) {\n  throw new Error(\"Nessuna riga del campione ha un valore valido per la colonna target '\" + targetColumn + \"'\");\n}\n\nconst featureColumns = columns.filter(c => c !== targetColumn);\n\nconst columnStats = {};\nfor (const col of featureColumns) {\n  const values = rows.map(r => r[col]).filter(v => v !== undefined && v !== \"\");\n  const numericValues = values.map(v => parseFloat(v)).filter(v => !isNaN(v));\n  if (values.length > 0 && numericValues.length === values.length) {\n    const mean = numericValues.reduce((a, b) => a + b, 0) / numericValues.length;\n    columnStats[col] = { type: \"numeric\", fallback: mean };\n  } else {\n    const freq = {};\n    values.forEach(v => { freq[v] = (freq[v] || 0) + 1; });\n    const mode = Object.keys(freq).reduce((a, b) => freq[a] > freq[b] ? a : b, values[0] || \"\");\n    columnStats[col] = { type: \"categorical\", fallback: mode };\n  }\n}\n\nreturn [{\n  json: {\n    rows, columns, featureColumns, targetColumn, columnStats,\n    task_type: trigger.task_type,\n    instance_features: trigger.instance_features\n  }\n}];"
      },
