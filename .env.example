# Copy this file to `.env` and fill in the values. The `.env` file must NEVER be committed.

# n8n version. For reproducibility, replace "stable" with the exact version used
# to develop the project (you can find it in n8n: Settings -> About).
N8N_VERSION=2.25.7

# Container time zone, as an IANA name (e.g. Europe/Rome, America/New_York).
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=Europe/Rome

# Encryption key for n8n credentials.
# Generate one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
